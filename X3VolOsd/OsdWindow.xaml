<Window x:Class="X3VolOsd.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X3 Vol OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        Opacity="0">
    <Border x:Name="RootBorder"
            CornerRadius="14"
            Background="#E6202020"
            BorderThickness="1"
            Padding="20,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.30" Color="Black"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="IconText"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="26"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Text="&#xE995;"/>
            <Border x:Name="TrackBar"
                    CornerRadius="3"
                    Height="6"
                    Width="200"
                    Background="#33FFFFFF"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">
                <Border x:Name="FillBar"
                        CornerRadius="3"
                        HorizontalAlignment="Left"
                        Background="White"
                        Width="0"/>
            </Border>
            <TextBlock x:Name="PercentText"
                       FontSize="15"
                       Foreground="White"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       TextAlignment="Right"
                       Width="54"
                       Margin="10,0,0,0"
                       Text="100%"/>
        </StackPanel>
    </Border>
</Window>
