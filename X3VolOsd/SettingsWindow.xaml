<Window x:Class="X3VolOsd.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X3 Vol OSD Settings"
        Width="420"
        Height="700"
        MinWidth="380"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <StackPanel Margin="20,20,16,18">

        <!-- Overlay appearance -->
        <Border CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,14">
            <StackPanel>
                <Grid Height="52" Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Position" FontSize="14" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                    <ComboBox x:Name="PositionCombo" Grid.Column="1" Width="170" VerticalAlignment="Center">
                        <ComboBoxItem Content="Top center"/>
                        <ComboBoxItem Content="Top right"/>
                        <ComboBoxItem Content="Bottom center"/>
                        <ComboBoxItem Content="Bottom right"/>
                    </ComboBox>
                </Grid>

                <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="14,0"/>

                <Grid Height="52" Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Theme" FontSize="14" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="170" VerticalAlignment="Center">
                        <ComboBoxItem Content="Match Windows"/>
                        <ComboBoxItem Content="Dark"/>
                        <ComboBoxItem Content="Light"/>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Per-theme colors -->
        <Border CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,14">
            <StackPanel>
                <Grid Height="52" Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Editing colors for" FontSize="14" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                    <ComboBox x:Name="ColorVariantCombo" Grid.Column="1" Width="170" VerticalAlignment="Center"
                              SelectionChanged="ColorVariantCombo_SelectionChanged">
                        <ComboBoxItem Content="Dark theme"/>
                        <ComboBoxItem Content="Light theme"/>
                    </ComboBox>
                </Grid>

                <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="14,0"/>

                <Grid Height="52" Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Background color" FontSize="14" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BackgroundSwatch" Width="24" Height="24" CornerRadius="4"
                                BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}" Margin="0,0,10,0"/>
                        <Button Content="Choose..." Click="ChooseBackgroundColor_Click"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="14,0"/>

                <Grid Height="52" Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Icon &amp; text color" FontSize="14" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="ForegroundSwatch" Width="24" Height="24" CornerRadius="4"
                                BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}" Margin="0,0,10,0"/>
                        <Button Content="Choose..." Click="ChooseForegroundColor_Click"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="14,0"/>

                <Grid Height="52" Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Bar fill color" FontSize="14" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BarSwatch" Width="24" Height="24" CornerRadius="4"
                                BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}" Margin="0,0,10,0"/>
                        <Button x:Name="BarChooseButton" Content="Choose..." Click="ChooseBarColor_Click"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="14,0"/>

                <Grid Height="52" Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Match Windows accent" FontSize="14" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                    <CheckBox x:Name="BarAccentCheck" Grid.Column="1" VerticalAlignment="Center"
                              Checked="BarAccent_Changed" Unchecked="BarAccent_Changed"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Sliders -->
        <Border CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Size" FontSize="14"/>
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource ValueLabelStyle}"
                               Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0:0.0}x}"/>
                </Grid>
                <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="2.0" TickFrequency="0.1"
                        IsSnapToTickEnabled="True" Margin="0,0,0,18"/>

                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Display duration" FontSize="14"/>
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource ValueLabelStyle}"
                               Text="{Binding Value, ElementName=DurationSlider, StringFormat={}{0:0.00}s}"/>
                </Grid>
                <Slider x:Name="DurationSlider" Minimum="0.5" Maximum="4.0" TickFrequency="0.25"
                        IsSnapToTickEnabled="True"/>
            </StackPanel>
        </Border>

        <!-- Knob device -->
        <Border CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,14">
            <StackPanel>
                <Grid Height="52" Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Knob device" FontSize="14" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                               ToolTip="Knob device"/>
                    <ComboBox x:Name="KnobDeviceCombo" Grid.Column="1" Width="200" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Margin="14,0,14,12" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           Text="The overlay only appears when this device's volume changes (your X3 hardware knob). Auto-detects SPDIF Out on first run. Pick None to disable."/>
            </StackPanel>
        </Border>

        <!-- Startup -->
        <Border CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,20">
            <Grid Height="52" Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Start with Windows" FontSize="14" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                <CheckBox x:Name="StartWithWindowsCheck" Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10,20,18">
            <Button x:Name="PreviewButton" Content="Preview" Margin="0,0,8,0" Click="PreviewButton_Click"/>
            <Button x:Name="SaveButton" Content="Save" Margin="0,0,8,0" Click="SaveButton_Click"
                    Style="{StaticResource AccentButtonStyle}" IsDefault="True"/>
            <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
